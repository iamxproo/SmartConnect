# SmartConnect local infrastructure — copy to `.env` (never commit `.env`).
# Generate secrets with:  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40
# Passwords must be URL-safe (letters/digits) because they are embedded in connection URLs.

# --- PostgreSQL (development instance, persistent volume) ---
POSTGRES_DB=smartconnect
POSTGRES_USER=smartconnect_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432

# --- PostgreSQL (isolated test instance, tmpfs, `--profile test`) ---
POSTGRES_TEST_DB=smartconnect_test
POSTGRES_TEST_USER=smartconnect_test_admin
POSTGRES_TEST_PASSWORD=change-me
POSTGRES_TEST_PORT=15433

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Service database credentials are NOT stored here. They are generated per service by
# `make db-bootstrap` into smartconnect-backend/services/<service>/.env (mode 600).
