{
  "name": "@smartconnect/backend-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared infrastructure for SmartConnect's NestJS processes: HTTP pipeline, RFC 9457 errors, request ids, validation, logging, health, OpenAPI conventions, access-token verification. No data models, no business logic.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "nodemailer": "10.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
