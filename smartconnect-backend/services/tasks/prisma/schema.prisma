// =============================================================================
// Tasks service: sole owner of PostgreSQL schema "tasks".
//   Design & rationale : docs/database/schema-design.md#tasks
//   Tenant isolation   : docs/database/tenant-isolation.md
// Conventions: UUIDv7 primary keys, snake_case tables/columns, timestamptz(3).
// Cross-service references are plain UUID columns WITHOUT foreign keys, annotated
// "→ <service>.<table> (logical)"; consistency across services is eventual (outbox events).
// RLS policies, CHECK constraints, triggers and functions are hand-written SQL appended to the
// migrations, because Prisma does not model them.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
  cancelled
}

enum TaskPriority {
  none
  low
  medium
  high
  urgent
}

model TaskList {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid /// → organization.organizations (logical)
  workspaceId     String?   @map("workspace_id") @db.Uuid /// → workspace.workspaces (logical)
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(2000)
  createdByUserId String    @map("created_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  tasks Task[]

  @@unique([organizationId, id])
  @@index([organizationId, workspaceId])
  @@map("task_lists")
}

model Task {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  taskListId      String       @map("task_list_id") @db.Uuid
  taskList        TaskList     @relation(fields: [organizationId, taskListId], references: [organizationId, id], onDelete: Cascade)
  parentTaskId    String?      @map("parent_task_id") @db.Uuid
  parentTask      Task?        @relation("Subtasks", fields: [organizationId, parentTaskId], references: [organizationId, id], onDelete: Cascade)
  title           String       @db.VarChar(500)
  description     String?
  status          TaskStatus   @default(todo)
  priority        TaskPriority @default(none)
  position        Float        @default(0) /// fractional ordering within the list; renormalized by the service
  dueAt           DateTime?    @map("due_at") @db.Timestamptz(3)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdByUserId String       @map("created_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)

  subtasks  Task[]         @relation("Subtasks")
  assignees TaskAssignee[]
  comments  TaskComment[]

  @@unique([organizationId, id])
  @@index([taskListId, status, position])
  @@index([parentTaskId], where: raw("parent_task_id IS NOT NULL"))
  @@index([organizationId, dueAt], map: "tasks_open_due_idx", where: raw("due_at IS NOT NULL AND completed_at IS NULL"))
  @@map("tasks")
}

model TaskAssignee {
  organizationId   String   @map("organization_id") @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  task             Task     @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)
  userId           String   @map("user_id") @db.Uuid /// → identity.users (logical)
  assignedByUserId String   @map("assigned_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([taskId, userId])
  @@index([organizationId, userId]) /// "my tasks"
  @@map("task_assignees")
}

model TaskComment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  task           Task      @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)
  authorUserId   String    @map("author_user_id") @db.Uuid /// → identity.users (logical)
  body           String    @db.VarChar(10000)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// ---------------------------------------------------------------------------
// Messaging infrastructure (identical in every service schema)
// ---------------------------------------------------------------------------

/// Transactional outbox. Domain events are inserted in the SAME transaction as the state change and
/// published afterwards by this service's relay. The durable source of events (Redis never is).
/// Not tenant-filtered: the relay processes all organizations.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid /// event id, time-ordered
  aggregateType  String    @map("aggregate_type") @db.VarChar(64)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(128) /// e.g. "<service>.<entity>.<past_tense_verb>"
  eventVersion   Int       @default(1) @map("event_version") @db.SmallInt
  organizationId String?   @map("organization_id") @db.Uuid /// routing only; null for global events
  payload        Json      @db.JsonB
  headers        Json      @default("{}") @db.JsonB /// correlation / trace ids
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(2000)

  @@index([occurredAt], map: "outbox_events_unpublished_idx", where: raw("published_at IS NULL"))
  @@index([publishedAt], map: "outbox_events_published_idx", where: raw("published_at IS NOT NULL"))
  @@map("outbox_events")
}

/// Idempotent-consumer log: one row per (event, handler) successfully processed.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@index([processedAt])
  @@map("processed_events")
}
