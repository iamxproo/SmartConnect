# Do not copy by hand: `make db-bootstrap` generates .env and .env.migration (mode 600) with real
# credentials. Shown here for reference only.

# .env — runtime (the NestJS service). Least-privilege role, subject to row-level security:
DATABASE_URL=postgresql://sc_administration_app:<password>@127.0.0.1:15432/smartconnect?schema=administration
DATABASE_SCHEMA=administration

# .env.migration — Prisma CLI only (schema owner). Never give this to the running service:
# MIGRATION_DATABASE_URL=postgresql://sc_administration_migrator:<password>@127.0.0.1:15432/smartconnect?schema=administration
