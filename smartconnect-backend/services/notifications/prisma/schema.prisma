// =============================================================================
// Notifications service: sole owner of PostgreSQL schema "notifications".
//   Design & rationale : docs/database/schema-design.md#notifications
//   Tenant isolation   : docs/database/tenant-isolation.md
// Conventions: UUIDv7 primary keys, snake_case tables/columns, timestamptz(3).
// Cross-service references are plain UUID columns WITHOUT foreign keys, annotated
// "→ <service>.<table> (logical)"; consistency across services is eventual (outbox events).
// RLS policies, CHECK constraints, triggers and functions are hand-written SQL appended to the
// migrations, because Prisma does not model them.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// In-app notifications (the `notifications` row IS the in-app delivery) plus push/email deliveries.
// Delivery workers claim due rows across tenants only through the SECURITY DEFINER function
// notifications.claim_notification_deliveries(), then process each row inside its tenant context.

enum NotificationLevel {
  all
  mentions
  none
}

enum NotificationScope {
  organization
  workspace
  channel
  conversation
}

enum DeliveryTransport {
  push
  email
}

enum DeliveryStatus {
  pending
  sending /// claimed by a worker until locked_until
  sent
  failed /// retryable; next_attempt_at set
  skipped /// suppressed by preferences / DND / no device
}

model Notification {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid /// → organization.organizations (logical)
  recipientUserId String    @map("recipient_user_id") @db.Uuid /// → identity.users (logical)
  actorUserId     String?   @map("actor_user_id") @db.Uuid /// → identity.users (logical)
  type            String    @db.VarChar(64) /// e.g. messaging.mention, tasks.assigned
  title           String    @db.VarChar(200)
  body            String?   @db.VarChar(1000)
  resourceType    String?   @map("resource_type") @db.VarChar(64)
  resourceId      String?   @map("resource_id") @db.Uuid
  data            Json      @default("{}") @db.JsonB
  groupKey        String?   @map("group_key") @db.VarChar(128) /// collapses related notifications (e.g. per thread)
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@unique([organizationId, id])
  @@index([organizationId, recipientUserId, createdAt(sort: Desc)])
  @@index([organizationId, recipientUserId], map: "notifications_unread_idx", where: raw("read_at IS NULL"))
  @@map("notifications")
}

/// Per-user preferences at a scope. scope_id = organization id for scope "organization", so the unique
/// key never contains NULL.
model NotificationPreference {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid /// → identity.users (logical)
  scopeType      NotificationScope @map("scope_type")
  scopeId        String            @map("scope_id") @db.Uuid
  level          NotificationLevel @default(all)
  pushEnabled    Boolean           @default(true) @map("push_enabled")
  emailEnabled   Boolean           @default(true) @map("email_enabled")
  mutedUntil     DateTime?         @map("muted_until") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, userId, scopeType, scopeId])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  notificationId    String            @map("notification_id") @db.Uuid
  notification      Notification      @relation(fields: [organizationId, notificationId], references: [organizationId, id], onDelete: Cascade)
  transport         DeliveryTransport
  status            DeliveryStatus    @default(pending)
  attemptCount      Int               @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?         @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil       DateTime?         @map("locked_until") @db.Timestamptz(3)
  providerMessageId String?           @map("provider_message_id") @db.VarChar(255)
  lastError         String?           @map("last_error") @db.VarChar(1000)
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([notificationId, transport])
  @@index([nextAttemptAt], map: "notification_deliveries_due_idx", where: raw("status = 'pending' OR status = 'failed' OR status = 'sending'"))
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Messaging infrastructure (identical in every service schema)
// ---------------------------------------------------------------------------

/// Transactional outbox. Domain events are inserted in the SAME transaction as the state change and
/// published afterwards by this service's relay. The durable source of events (Redis never is).
/// Not tenant-filtered: the relay processes all organizations.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid /// event id, time-ordered
  aggregateType  String    @map("aggregate_type") @db.VarChar(64)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(128) /// e.g. "<service>.<entity>.<past_tense_verb>"
  eventVersion   Int       @default(1) @map("event_version") @db.SmallInt
  organizationId String?   @map("organization_id") @db.Uuid /// routing only; null for global events
  payload        Json      @db.JsonB
  headers        Json      @default("{}") @db.JsonB /// correlation / trace ids
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(2000)

  @@index([occurredAt], map: "outbox_events_unpublished_idx", where: raw("published_at IS NULL"))
  @@index([publishedAt], map: "outbox_events_published_idx", where: raw("published_at IS NOT NULL"))
  @@map("outbox_events")
}

/// Idempotent-consumer log: one row per (event, handler) successfully processed.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@index([processedAt])
  @@map("processed_events")
}
