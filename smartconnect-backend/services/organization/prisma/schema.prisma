// =============================================================================
// Organization service: sole owner of PostgreSQL schema "organization".
//   Design & rationale : docs/database/schema-design.md#organization
//   Tenant isolation   : docs/database/tenant-isolation.md
// Conventions: UUIDv7 primary keys, snake_case tables/columns, timestamptz(3).
// Cross-service references are plain UUID columns WITHOUT foreign keys, annotated
// "→ <service>.<table> (logical)"; consistency across services is eventual (outbox events).
// RLS policies, CHECK constraints, triggers and functions are hand-written SQL appended to the
// migrations, because Prisma does not model them.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// The tenant root. organization_id in every other service refers to organizations.id here (logically).

enum OrganizationStatus {
  active
  suspended
}

enum MemberStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum TeamVisibility {
  public /// visible to every organization member
  private /// visible to its members and to holders of teams.manage
}

enum TeamRole {
  lead
  member
}

/// A tenant. Soft-deleted with a 30-day restore window; then `organization.deleted` triggers a hard
/// purge in every service.
model Organization {
  id              String             @id @default(uuid(7)) @db.Uuid
  slug            String             @db.VarChar(63) /// URL handle; globally unique among live organizations
  name            String             @db.VarChar(120)
  description     String?            @db.VarChar(1000)
  settings        Json               @default("{}") @db.JsonB /// validated by the service, e.g. { invitationExpiryDays }
  status          OrganizationStatus @default(active)
  createdByUserId String             @map("created_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)

  roles       OrganizationRole[]
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  departments Department[]
  teams       Team[]

  @@unique([slug], map: "organizations_slug_live_key", where: raw("deleted_at IS NULL"))
  @@map("organizations")
}

/// Built-in (owner/admin/member/guest, is_system) and custom roles. Permissions are string keys
/// validated by the service (e.g. "workspace.create", "member.invite").
model OrganizationRole {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String       @db.VarChar(64)
  name           String       @db.VarChar(80)
  description    String?      @db.VarChar(500)
  permissions    String[]
  isSystem       Boolean      @default(false) @map("is_system")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  @@unique([organizationId, key])
  @@unique([organizationId, id]) /// target of tenant-safe composite foreign keys
  @@map("organization_roles")
}

/// Membership of a user in an organization. Leaving deletes the row (history lives in audit logs).
model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id") @db.Uuid /// → identity.users (logical)
  roleId         String           @map("role_id") @db.Uuid
  role           OrganizationRole @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  status         MemberStatus     @default(active)
  title          String?          @db.VarChar(120) /// job title within this organization
  displayName    String?          @map("display_name") @db.VarChar(80) /// projection of identity user_profiles.display_name, taken at join
  email          String?          @db.VarChar(320) /// projection of identity users.email, taken at join (PII: erased with the user)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, userId])
  @@index([userId]) /// "which organizations am I in?" (the one deliberate cross-tenant read; see RLS)
  @@index([organizationId, roleId])
  @@map("organization_members")
}

/// Email invitation. Only the SHA-256 of the invitation token is stored; the token is resolved to its
/// organization via the SECURITY DEFINER function organization.resolve_invitation_token().
model OrganizationInvitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailNormalized  String           @map("email_normalized") @db.VarChar(320)
  roleId           String           @map("role_id") @db.Uuid
  role             OrganizationRole @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid /// → identity.users (logical)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  status           InvitationStatus @default(pending)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, emailNormalized], map: "organization_invitations_pending_email_key", where: raw("status = 'pending'"))
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("organization_invitations")
}

/// Organizational units (G-01), optionally nested. Membership lives on teams, not on departments.
model Department {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId        String?      @map("parent_id") @db.Uuid
  parent          Department?  @relation("DepartmentTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: NoAction)
  children        Department[] @relation("DepartmentTree")
  name            String       @db.VarChar(120)
  description     String?      @db.VarChar(1000)
  createdByUserId String       @map("created_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  teams Team[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, parentId])
  @@map("departments")
}

/// Teams (G-01): explicit membership; private teams are visible only to their members and team managers.
model Team {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId    String?        @map("department_id") @db.Uuid
  department      Department?    @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: NoAction)
  name            String         @db.VarChar(120)
  description     String?        @db.VarChar(1000)
  visibility      TeamVisibility
  createdByUserId String         @map("created_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  members TeamMember[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, departmentId])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  team           Team     @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  userId         String   @map("user_id") @db.Uuid /// → identity.users (logical); an active organization member
  role           TeamRole @default(member)
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([teamId, userId])
  @@index([organizationId, userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Messaging infrastructure (identical in every service schema)
// ---------------------------------------------------------------------------

/// Transactional outbox. Domain events are inserted in the SAME transaction as the state change and
/// published afterwards by this service's relay. The durable source of events (Redis never is).
/// Not tenant-filtered: the relay processes all organizations.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid /// event id, time-ordered
  aggregateType  String    @map("aggregate_type") @db.VarChar(64)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(128) /// e.g. "<service>.<entity>.<past_tense_verb>"
  eventVersion   Int       @default(1) @map("event_version") @db.SmallInt
  organizationId String?   @map("organization_id") @db.Uuid /// routing only; null for global events
  payload        Json      @db.JsonB
  headers        Json      @default("{}") @db.JsonB /// correlation / trace ids
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(2000)

  @@index([occurredAt], map: "outbox_events_unpublished_idx", where: raw("published_at IS NULL"))
  @@index([publishedAt], map: "outbox_events_published_idx", where: raw("published_at IS NOT NULL"))
  @@map("outbox_events")
}

/// Idempotent-consumer log: one row per (event, handler) successfully processed.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@index([processedAt])
  @@map("processed_events")
}
