// =============================================================================
// Workspace service: sole owner of PostgreSQL schema "workspace".
//   Design & rationale : docs/database/schema-design.md#workspace
//   Tenant isolation   : docs/database/tenant-isolation.md
// Conventions: UUIDv7 primary keys, snake_case tables/columns, timestamptz(3).
// Cross-service references are plain UUID columns WITHOUT foreign keys, annotated
// "→ <service>.<table> (logical)"; consistency across services is eventual (outbox events).
// RLS policies, CHECK constraints, triggers and functions are hand-written SQL appended to the
// migrations, because Prisma does not model them.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Workspaces and channels. Channel *messages* live in the messaging service (conversations.channel_id);
// channel membership here is authoritative and projected into messaging via events.
// Candidate `channel_permissions` deferred: channels.posting_policy + channel_members.role cover the
// required cases without a per-channel ACL table.

enum WorkspaceVisibility {
  open /// any organization member may join
  private /// invitation only
}

enum WorkspaceRole {
  admin
  member
  guest
}

enum ChannelType {
  public
  private
}

enum ChannelPostingPolicy {
  everyone
  admins_only
}

enum ChannelRole {
  admin
  member
}

model Workspace {
  id              String              @id @default(uuid(7)) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid /// → organization.organizations (logical); tenant key
  name            String              @db.VarChar(80)
  slug            String              @db.VarChar(63)
  description     String?             @db.VarChar(1000)
  visibility      WorkspaceVisibility @default(open)
  createdByUserId String              @map("created_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?           @map("archived_at") @db.Timestamptz(3)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)

  members  WorkspaceMember[]
  channels Channel[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug], map: "workspaces_org_slug_live_key", where: raw("deleted_at IS NULL"))
  @@map("workspaces")
}

model WorkspaceMember {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  workspace      Workspace     @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  userId         String        @map("user_id") @db.Uuid /// → identity.users (logical)
  role           WorkspaceRole @default(member)
  joinedAt       DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([workspaceId, userId])
  @@index([organizationId, userId])
  @@map("workspace_members")
}

model Channel {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  workspace       Workspace            @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  name            String               @db.VarChar(80) /// lowercase, unique per workspace among live channels
  topic           String?              @db.VarChar(250)
  description     String?              @db.VarChar(1000)
  type            ChannelType          @default(public)
  postingPolicy   ChannelPostingPolicy @default(everyone) @map("posting_policy")
  isDefault       Boolean              @default(false) @map("is_default") /// auto-joined by new workspace members
  createdByUserId String               @map("created_by_user_id") @db.Uuid /// → identity.users (logical)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?            @map("archived_at") @db.Timestamptz(3)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(3)

  members ChannelMember[]

  @@unique([organizationId, id])
  @@unique([workspaceId, name], map: "channels_workspace_name_live_key", where: raw("deleted_at IS NULL"))
  @@map("channels")
}

model ChannelMember {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  channelId      String      @map("channel_id") @db.Uuid
  channel        Channel     @relation(fields: [organizationId, channelId], references: [organizationId, id], onDelete: Cascade)
  userId         String      @map("user_id") @db.Uuid /// → identity.users (logical)
  role           ChannelRole @default(member)
  joinedAt       DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([channelId, userId])
  @@index([organizationId, userId])
  @@map("channel_members")
}

// ---------------------------------------------------------------------------
// Messaging infrastructure (identical in every service schema)
// ---------------------------------------------------------------------------

/// Transactional outbox. Domain events are inserted in the SAME transaction as the state change and
/// published afterwards by this service's relay. The durable source of events (Redis never is).
/// Not tenant-filtered: the relay processes all organizations.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid /// event id, time-ordered
  aggregateType  String    @map("aggregate_type") @db.VarChar(64)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(128) /// e.g. "<service>.<entity>.<past_tense_verb>"
  eventVersion   Int       @default(1) @map("event_version") @db.SmallInt
  organizationId String?   @map("organization_id") @db.Uuid /// routing only; null for global events
  payload        Json      @db.JsonB
  headers        Json      @default("{}") @db.JsonB /// correlation / trace ids
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(2000)

  @@index([occurredAt], map: "outbox_events_unpublished_idx", where: raw("published_at IS NULL"))
  @@index([publishedAt], map: "outbox_events_published_idx", where: raw("published_at IS NOT NULL"))
  @@map("outbox_events")
}

/// Idempotent-consumer log: one row per (event, handler) successfully processed.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, handler])
  @@index([processedAt])
  @@map("processed_events")
}
