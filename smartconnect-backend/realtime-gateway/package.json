{
  "name": "@smartconnect/realtime-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "SmartConnect realtime gateway (ADR 0004): authenticated Socket.IO connections; channel rooms authorized through the workspace service; fans out id-only events published by services after commit. Stateless: no database, no schema.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @smartconnect/backend-kit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "pretypecheck": "npm run build --workspace @smartconnect/backend-kit",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build --workspace @smartconnect/backend-kit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@redis/client": "6.3.0",
    "@smartconnect/backend-kit": "0.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jose": "6.2.13",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
