# ---- Secrets: never commit ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
.secrets/

# ---- Dependencies / build output ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ---- Prisma generated clients (regenerated by `prisma generate`) ----
smartconnect-backend/services/*/src/generated/

# ---- Database backups (may contain production data / PII) ----
infrastructure/backup/output/
*.dump
*.sql.gz

# ---- OS / editor ----
.DS_Store
*.log

# ---- Local file storage (files service, development) ----
.local/
